# Local editor and dev-tooling config, and personal project notes — not part of the app
.mcp.json
.agents/
.claude/
.codex/
CLAUDE.md
AGENTS.md
SKILLS.md
skills-lock.json
docs/obsidian/
docs/github/

# Env / secrets — only public EXPO_PUBLIC_* keys ever belong in the app bundle.
# Service-role / backend secrets must live on a backend, never in app source.
# (.env.example is intentionally NOT ignored — it holds placeholders only.)
.env
.env.local
.env.*.local
# Seed-script credentials (Supabase service-role key) — server-side only.
.env.seed
# Local edge-function secrets for `supabase functions serve`.
supabase/functions/.env

# Dependencies
node_modules/

# Expo / Metro / TypeScript build output
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Native — managed workflow regenerates these via `expo prebuild` (CNG)
/ios
/android
.kotlin/

# Native signing material — never commit
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Merge artifacts
*.orig.*

# OS
.DS_Store

# VA accreditation raw export (converted to vso-representatives.json)
ingestion/data/repexcellist.asp
