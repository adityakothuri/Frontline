{
  "name": "frontline",
  "version": "1.0.0",
  "description": "React Native + Expo app that helps veterans find benefits, local resources, and AI-generated next steps.",
  "keywords": [
    "veterans",
    "react-native",
    "expo",
    "benefits",
    "supabase",
    "typescript"
  ],
