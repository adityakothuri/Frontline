# Watchdog — example environment variables (PLACEHOLDERS ONLY).
#
# Copy this file to `.env.local` and fill in real values there.
# NEVER put real secrets in this file or commit them. `.env*` is git-ignored;
# `.env.example` is committed and must contain placeholders only.
#
# Mobile apps ship their bundle, so ONLY public client keys (EXPO_PUBLIC_*) belong
# in the app. Service-role / admin / backend secrets must live on a backend or in
# the deployment environment — never in app source.
#
# Nothing below is used by the MVP yet (the MVP is fully simulated). These are
# forward-looking placeholders for when real integrations are approved.

# --- App config ---
EXPO_PUBLIC_APP_ENV=development

# --- Supabase (if/when a real backend is added — Priority 9) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Map provider (if/when a real map is added — Phase 5) ---
EXPO_PUBLIC_MAPBOX_TOKEN=
