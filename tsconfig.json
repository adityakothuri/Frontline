{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Node runs the ingestion/ and scripts/ tooling via native TS type-stripping,
    // which requires explicit .ts extensions on relative imports. Safe here: the
    // project only ever type-checks with `tsc --noEmit` (bundling is Metro's job).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "supabase/functions"]
}
